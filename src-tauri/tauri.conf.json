{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prompt History",
  "version": "0.1.1",
  "identifier": "com.schoox.prompt-history-logger",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Prompt History", "width": 1280, "height": 820, "minWidth": 800, "minHeight": 500 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
